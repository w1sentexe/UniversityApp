# Период парсинга. Меняется вручную раз в полгода при смене семестра,
# после чего контейнер пересобирается/перезапускается.
PARSING_YEAR=2025-2026
PARSING_SEMESTER=0

# Логирование: DEBUG / INFO / WARNING / ERROR (легаси-алиас DEV = INFO)
LOG_LEVEL=INFO

# База данных (SQLite). В контейнере — путь внутри примонтированного тома,
# при локальной отладке — файл рядом с проектом.
DB_PATH=/data/rating.sqlite3

# Планировщик
SCHEDULER_INTERVAL_MINUTES=10

# Web Push уведомления.
# 1. uv run python -m py_vapid --gen
# 2. uv run python -m py_vapid --applicationServerKey --private-key private_key.pem
# В public key кладётся значение applicationServerKey, в private key — путь к PEM
# внутри контейнера или encoded private key.
NOTIFICATIONS_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=
NOTIFICATIONS_VAPID_SUBJECT=mailto:admin@example.com

# Токен для ручного curl-эндпоинта PATCH /rating/test/final-rating.
# Если пусто, ручка выключена.
TEST_MUTATION_TOKEN=
